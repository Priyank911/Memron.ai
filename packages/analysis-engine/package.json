{
  "name": "@memron/analysis-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:episodes": "vitest run --testNamePattern=episode",
    "test:extraction": "vitest run --testNamePattern=extractor",
    "test:analysis": "vitest run --testNamePattern=analyzer",
    "test:distill": "vitest run --testNamePattern=distiller",
    "test:evolution": "vitest run --testNamePattern=evolution",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@memron/shared-types": "workspace:*",
    "nanoid": "^5.0.0",
    "openai": "^7.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
