# ─────────────────────────────────────────
# Memron Landing App — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Vercel: Add these in Project Settings → Environment Variables

# ─── Clerk Authentication ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ─── PostgreSQL (Supabase — Primary Database) ───
PG_HOST=db.your-project.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your-password
# Optional: Aiven CA certificate for SSL verification
# PG_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ─── Firebase (Backup Database — Optional) ───
# If omitted, the app works with PostgreSQL only
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ─── App Config ───
NODE_ENV=development
# MCP server URL (for future API key → MCP connection flow)
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:4201
