# ─────────────────────────────────────────
# Memron Landing App — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Vercel: Add these in Project Settings → Environment Variables

# ─── WorkOS AuthKit (Authentication) ───
# Get these from https://dashboard.workos.com → API Keys
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
# Random string, MIN 32 chars — used to encrypt (seal) session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKOS_COOKIE_PASSWORD=change-me-to-a-random-32-plus-char-string

# WorkOS Dashboard setup checklist:
#   1. AuthKit → Enable "Password" authentication
#   2. Redirect URLs → add:  http://localhost:3000/api/auth/callback  (and your prod origin)
#   3. OAuth apps (optional): connect Google / GitHub under "OAuth"
#   4. Emails: verification + password-reset emails are sent by WorkOS

# ─── Firebase (Firestore backup database ONLY — no longer used for auth) ───
# Optional. When set, user records are mirrored to Firestore as a fallback store.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── PostgreSQL (Aiven — Primary Database) ───
PG_HOST=memron-xxx.aivencloud.com
PG_PORT=27847
PG_DATABASE=defaultdb
PG_USER=avnadmin
PG_PASSWORD=your-aiven-password
PG_SSL=true

# ─── PostgreSQL (Supabase — MCP Server Mirror) ───
# The MCP server reads from Supabase. The landing app mirrors API keys here.
# If these are NOT set, sync is skipped and MCP auth will FAIL with 401.
SUPABASE_PG_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_PG_PORT=5432
SUPABASE_PG_DATABASE=postgres
SUPABASE_PG_USER=postgres.xxxxx
SUPABASE_PG_PASSWORD=your-supabase-password
SUPABASE_PG_SSL=true

# ─── App Config ───
NODE_ENV=development
# MCP server URL shown in the dashboard config snippet
NEXT_PUBLIC_MCP_URL=http://localhost:4201/mcp

# ─── OpenAI AI Engine (Playground RAG+LLM + Embeddings) ───
# Powers semantic vector search (text-embedding-3-small) and RAG reasoning (gpt-4o-mini)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── Email Notifications (Optional — Resend) ───
# If set, bucket share notifications are sent via email.
# Sign up at https://resend.com and create an API key.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Memron <noreply@memron.ai>
# NEXT_PUBLIC_APP_URL=https://memron.ai
