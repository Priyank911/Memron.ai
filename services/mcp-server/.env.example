# ─────────────────────────────────────────
# Memron MCP Server — Environment Variables
# ─────────────────────────────────────────
# Copy to .env in this directory for local dev.
# For Railway/Render: Add in their dashboard.\
# Server
PORT=4201
NODE_ENV=development
MCP_SERVER_URL=http://localhost:4201

# PostgreSQL (Supabase Session Pooler — same database as landing app)
# Direct host is IPv6-only, use session pooler (port 5432) for IPv4 environments
# Transaction pooler (port 6543) does NOT support prepared statements
PG_HOST=aws-1-ap-south-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.clfkehjbbvsbllonxrlz
PG_PASSWORD=
# For local dev with docker-compose:
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=memron
# PG_USER=memron
# PG_PASSWORD=memron
# PG_SSL=false

# Encryption (AES-256-GCM key derivation secret)
# MUST be at least 32 characters. Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=memron-dev-encryption-key-change-in-production

# JWT (for OAuth access + refresh tokens)
# Generate with: openssl rand -hex 32
JWT_SECRET=memron-dev-jwt-secret-change-in-production
JWT_ISSUER=http://localhost:4201

# Landing app URL (for "Get API Key" link on OAuth login page)
LANDING_URL=http://localhost:3000

# ─── VS Code MCP Client Config ───
# Add this to your VS Code settings.json or .vscode/mcp.json:
# {
#   "mcpServers": {
#     "memron": {
#       "url": "http://localhost:4201/mcp"
#     }
#   }
# }
