{
  "name": "@memron/mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Memron MCP Server — Sovereign memory operations via Model Context Protocol",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "railway:logs": "echo 'Use: railway logs -s memron-mcp' && railway logs"
  },
  "dependencies": {
    "@memron/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
