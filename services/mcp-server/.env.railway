# ─────────────────────────────────────────
# Memron MCP Server — Railway Environment Variables
# ─────────────────────────────────────────
# Copy these to the Railway dashboard → Variables tab.
# Railway auto-injects PORT, RAILWAY_ENVIRONMENT, RAILWAY_PUBLIC_DOMAIN.
# Do NOT set PORT — Railway provides it automatically.
# Do NOT set MCP_SERVER_URL — auto-detected from RAILWAY_PUBLIC_DOMAIN.
# ─────────────────────────────────────────

NODE_ENV=production

# ─── PostgreSQL (Supabase Session Pooler) ───
PG_HOST=aws-1-ap-south-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.clfkehjbbvsbllonxrlz
PG_PASSWORD=<SET_IN_RAILWAY_DASHBOARD>
PG_SSL=true

# ─── Encryption (AES-256-GCM — generate with: openssl rand -hex 32) ───
ENCRYPTION_SECRET=<SET_IN_RAILWAY_DASHBOARD>

# ─── JWT (generate with: openssl rand -hex 32) ───
JWT_SECRET=<SET_IN_RAILWAY_DASHBOARD>
# JWT_ISSUER is auto-derived from server URL — only set to override

# ─── Landing App URL ───
LANDING_URL=https://console.memron.ai

# ─── Optional: Rate Limiting ───
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# ─── Optional: Session ───
# SESSION_IDLE_MS=1800000
