# ─────────────────────────────────────────
# Memron MCP Server — Production Dockerfile
# ─────────────────────────────────────────
# Builds: services/mcp-server
# Deploy: Railway, Render, Fly.io, or any Docker host
#
# Build:  docker build -f infra/docker/Dockerfile.mcp -t memron-mcp .
# Run:    docker run -p 4201:4201 --env-file services/mcp-server/.env memron-mcp

# ── Base ──
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# ── Install dependencies ──
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY services/mcp-server/package.json   ./services/mcp-server/

RUN pnpm install --frozen-lockfile --filter @memron/mcp-server...

# ── Build ──
FROM deps AS build
COPY tsconfig.base.json turbo.json ./
COPY packages/shared-types/ ./packages/shared-types/
COPY services/mcp-server/   ./services/mcp-server/

RUN pnpm turbo build --filter=@memron/mcp-server

# ── Prune dev dependencies ──
RUN pnpm prune --prod --filter @memron/mcp-server... \
 && rm -rf /app/.turbo /app/*/.turbo /app/*/*/.turbo

# ── Production ──
FROM node:22-alpine AS production
RUN apk add --no-cache dumb-init \
 && addgroup -g 1001 -S memron \
 && adduser  -u 1001 -S memron -G memron
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4201

# Copy built artifacts + production node_modules
COPY --from=build --chown=memron:memron /app/packages/shared-types/dist        ./packages/shared-types/dist
COPY --from=build --chown=memron:memron /app/packages/shared-types/package.json ./packages/shared-types/
COPY --from=build --chown=memron:memron /app/services/mcp-server/dist          ./services/mcp-server/dist
COPY --from=build --chown=memron:memron /app/services/mcp-server/package.json  ./services/mcp-server/
COPY --from=build --chown=memron:memron /app/services/mcp-server/public        ./services/mcp-server/public
COPY --from=build --chown=memron:memron /app/node_modules                      ./node_modules
COPY --from=build --chown=memron:memron /app/services/mcp-server/node_modules  ./services/mcp-server/node_modules
COPY --from=build --chown=memron:memron /app/packages/shared-types/node_modules ./packages/shared-types/node_modules

USER memron
WORKDIR /app/services/mcp-server

EXPOSE 4201

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-4201}/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
