# ══════════════════════════════════════════════════════════════
#  Memron AI — Root Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy to .env.local at the repo root.
# Each app/service also has its own .env.example with more detail.
#
# For Vercel: Add landing vars in Vercel Dashboard → Settings → Env Vars
# For Railway/Render: Add MCP vars in their respective dashboards
# ══════════════════════════════════════════════════════════════

# ─── General ───
NODE_ENV=development

# ─── Shared: PostgreSQL (Supabase) ───
# Both landing app and MCP server share the same database
PG_HOST=db.clfkehjbbvsbllonxrlz.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
# PG_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ─── Landing App (apps/landing) — port 3000 ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Firebase (optional backup DB — leave blank to run PG-only)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─── MCP Server (services/mcp-server) — port 5201 ───
MCP_SERVER_URL=http://localhost:5201
ENCRYPTION_SECRET=memron-dev-encryption-key-CHANGE-IN-PRODUCTION
JWT_SECRET=memron-dev-jwt-secret-CHANGE-IN-PRODUCTION
JWT_ISSUER=http://localhost:5201
LANDING_URL=http://localhost:3000

# ─── MCP Server for VS Code / Claude Desktop ───
# Add this to your MCP client config:
# {
#   "mcpServers": {
#     "memron": {
#       "url": "http://localhost:5201/mcp"
#     }
#   }
# }
